# Test harness configuration. Copy to .env (gitignored) and adjust if your
# workspace differs:  cp .env.example .env

# Repositories (absolute paths on this workstation)
MINIO_REPO=/Users/aursu/workspace/code/minio
CONSOLE_REPO=/Users/aursu/workspace/code/console

# Go toolchain image; moves with the go.mod toolchain (plan 04, step 2.2)
GO_IMAGE=golang:1.27.4

# Docker volumes reused between runs
GO_MODULE_CACHE_VOLUME=minio-gomod
GO_BUILD_CACHE_VOLUME=minio-gocache-unprivileged

# Logs of every run (gitignored)
TEST_RESULTS_DIR=${MINIO_REPO}/fork/test/results
